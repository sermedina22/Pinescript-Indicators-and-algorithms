///### Adding self-terminating lines
extendAndRemove( array<line> lineArray,  simple bool isBull, int maxSize) =>  
    if lineArray.size() > 0
        for i = lineArray.size() -1 to 0
            line ln = lineArray.get(i)
            ln.set_x2(bar_index)
            float price = ln.get_price(bar_index)                 
            int m = isBull ? 1 : -1
            float hiLo = isBull ? high : low  
            if hiLo * m > price * m 
                lineArray.remove(i)
    if lineArray.size() > maxSize
        line.delete(lineArray.shift())

